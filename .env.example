# ==============================================================================
# Siri Sofa Services — Production Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. SERVER SECURITY & ADMIN CREDENTIALS
# ------------------------------------------------------------------------------
SECRET_KEY=siri-sofa-change-this-random-secret-key-in-production
ADMIN_EMAIL=admin@sirisofa.com
ADMIN_PASSWORD=change_this_to_strong_password
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ------------------------------------------------------------------------------
# 1. REAL EMAIL DISPATCH (SMTP - Works with Gmail, Outlook, Brevo, AWS SES)
# ------------------------------------------------------------------------------
# For Gmail:
#   1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
#   2. Create App Password named "Siri Sofa"
#   3. Paste the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Siri Sofa Services

# ------------------------------------------------------------------------------
# 2. REAL SMS DISPATCH (Fast2SMS / Twilio)
# ------------------------------------------------------------------------------
# Option A: Fast2SMS (Free signup credits, delivers direct OTPs across India)
# Get key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option C: Custom SMS Webhook
SMS_WEBHOOK_URL=
